@{
    ViewData["Title"] = "Dashboard";
    ViewData["ShowBreadcrumb"] = false;
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-speedometer2"></i> Dashboard</h2>
            <span class="badge bg-secondary">Phase 1: Accounting & Financial Management</span>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <!-- Chart of Accounts Stats -->
    <div class="col-md-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2 text-muted">Total Accounts</h6>
                        <h2 class="card-title mb-0">@ViewBag.TotalAccounts</h2>
                    </div>
                    <div class="text-primary">
                        <i class="bi bi-list-ul" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        @ViewBag.HeaderAccounts headers, @ViewBag.DetailAccounts details
                    </small>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="ChartOfAccounts" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                    <i class="bi bi-arrow-right"></i> View Chart of Accounts
                </a>
            </div>
        </div>
    </div>

    <!-- Fiscal Years Stats -->
    <div class="col-md-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2 text-muted">Fiscal Years</h6>
                        <h2 class="card-title mb-0">@ViewBag.TotalFiscalYears</h2>
                    </div>
                    <div class="text-success">
                        <i class="bi bi-calendar-range" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        @ViewBag.OpenFiscalYears open year(s)
                    </small>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="FiscalPeriods" asp-action="Index" class="btn btn-sm btn-outline-success w-100">
                    <i class="bi bi-arrow-right"></i> View Fiscal Periods
                </a>
            </div>
        </div>
    </div>

    <!-- Current Period -->
    <div class="col-md-3">
        <div class="card border-info h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-2 text-muted">Current Period</h6>
                        @if (ViewBag.CurrentPeriod != null)
                        {
                            <h5 class="card-title mb-0">@ViewBag.CurrentPeriod.PeriodName</h5>
                        }
                        else
                        {
                            <h5 class="card-title mb-0 text-muted">None</h5>
                        }
                    </div>
                    <div class="text-info">
                        <i class="bi bi-calendar-check" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <div class="mt-3">
                    @if (ViewBag.CurrentPeriod != null)
                    {
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            @ViewBag.CurrentPeriod.StartDate.ToString("MMM dd") - @ViewBag.CurrentPeriod.EndDate.ToString("MMM dd, yyyy")
                        </small>
                    }
                    else
                    {
                        <small class="text-muted">
                            <i class="bi bi-exclamation-circle"></i>
                            No active fiscal period
                        </small>
                    }
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-controller="FiscalPeriods" asp-action="Periods" class="btn btn-sm btn-outline-info w-100">
                    <i class="bi bi-arrow-right"></i> View All Periods
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-3 text-muted">Quick Actions</h6>
                <div class="d-grid gap-2">
                    <a asp-controller="ChartOfAccounts" asp-action="Create" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i> New Account
                    </a>
                    <a asp-controller="FiscalPeriods" asp-action="CreateYear" class="btn btn-sm btn-success">
                        <i class="bi bi-calendar-plus"></i> New Fiscal Year
                    </a>
                    <button class="btn btn-sm btn-secondary" disabled>
                        <i class="bi bi-journal-plus"></i> New Journal Entry
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Account Breakdown -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Accounts by Type</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.AccountsByType != null && ViewBag.AccountsByType.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Account Type</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ViewBag.AccountsByType)
                                {
                                    var percentage = (item.Count * 100.0 / ViewBag.TotalAccounts).ToString("F1");
                                    <tr>
                                        <td>@item.TypeName</td>
                                        <td class="text-end">
                                            <span class="badge bg-secondary">@item.Count</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="progress" style="height: 20px; width: 100px; float: right;">
                                                <div class="progress-bar" role="progressbar"
                                                     style="width: @percentage%"
                                                     aria-valuenow="@item.Count"
                                                     aria-valuemin="0"
                                                     aria-valuemax="@ViewBag.TotalAccounts">
                                                    @percentage%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No account data available</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> System Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">System Name:</dt>
                    <dd class="col-sm-7">VCI-IAMS</dd>

                    <dt class="col-sm-5">Institution:</dt>
                    <dd class="col-sm-7">Valencia Colleges (Bukidnon), Inc.</dd>

                    <dt class="col-sm-5">Current Phase:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-primary">Phase 1</span> Accounting & Financial Management
                    </dd>

                    <dt class="col-sm-5">Version:</dt>
                    <dd class="col-sm-7">1.0.0</dd>

                    <dt class="col-sm-5">Technology:</dt>
                    <dd class="col-sm-7">ASP.NET Core MVC / SQL Server</dd>

                    <dt class="col-sm-5">Deployment:</dt>
                    <dd class="col-sm-7">On-Premises Web Application</dd>

                    <dt class="col-sm-5">Current User:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-info">Admin</span>
                    </dd>

                    <dt class="col-sm-5">Status:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i> Operational
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Coming Soon Section -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Implementation Roadmap</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <h6 class="text-primary">
                            <i class="bi bi-check-circle-fill"></i> Phase 1 (Current)
                        </h6>
                        <ul class="list-unstyled ms-3">
                            <li><i class="bi bi-check text-success"></i> Chart of Accounts</li>
                            <li><i class="bi bi-check text-success"></i> Fiscal Periods</li>
                            <li class="text-muted"><i class="bi bi-hourglass-split"></i> Journal Entries (Next)</li>
                            <li class="text-muted"><i class="bi bi-hourglass-split"></i> AP/AR</li>
                            <li class="text-muted"><i class="bi bi-hourglass-split"></i> Student Accounting</li>
                            <li class="text-muted"><i class="bi bi-hourglass-split"></i> Financial Reports</li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-secondary">
                            <i class="bi bi-circle"></i> Phase 2 (Future)
                        </h6>
                        <ul class="list-unstyled ms-3 text-muted">
                            <li><i class="bi bi-circle"></i> Inventory Management</li>
                            <li><i class="bi bi-circle"></i> Asset Management</li>
                            <li><i class="bi bi-circle"></i> Property Accountability</li>
                            <li><i class="bi bi-circle"></i> Stock Reports</li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-secondary">
                            <i class="bi bi-circle"></i> Phase 3 (Future)
                        </h6>
                        <ul class="list-unstyled ms-3 text-muted">
                            <li><i class="bi bi-circle"></i> Employee Management</li>
                            <li><i class="bi bi-circle"></i> Attendance & Leave</li>
                            <li><i class="bi bi-circle"></i> Payroll Processing</li>
                            <li><i class="bi bi-circle"></i> HR Reports</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
