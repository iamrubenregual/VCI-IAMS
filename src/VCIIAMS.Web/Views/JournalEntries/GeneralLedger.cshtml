@model IEnumerable<JournalEntryLine>

@{
    ViewData["Title"] = "General Ledger Detail";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/JournalEntries'>Journal Entries</a></li><li class='breadcrumb-item active'>General Ledger</li>";

    decimal totalDebits = Model?.Sum(l => l.DebitAmount) ?? 0;
    decimal totalCredits = Model?.Sum(l => l.CreditAmount) ?? 0;
}

<div class="row mb-3 align-items-center">
    <div class="col-md-8">
        <h2><i class="bi bi-book me-2"></i>General Ledger Detail</h2>
        <p class="text-muted mb-0">Detailed listing of all individual debit and credit transactions posted from journal entries.</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Index" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i> Journal Entries
        </a>
        <button onclick="window.print()" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i> Print GL Report
        </button>
    </div>
</div>

<!-- Filter Card -->
<div class="card mb-4 shadow-sm d-print-none">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Account</label>
                <select name="accountId" class="form-select" asp-items="ViewBag.Accounts">
                    <option value="">-- All Accounts --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Fiscal Period</label>
                <select name="fiscalPeriodId" class="form-select" asp-items="ViewBag.FiscalPeriods">
                    <option value="">-- All Periods --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">From Date</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">To Date</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-1 text-end">
                <button type="submit" class="btn btn-primary w-100" title="Apply Filters">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- GL Detail Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Date</th>
                            <th style="width: 130px;">Journal #</th>
                            <th style="width: 120px;">Account Code</th>
                            <th>Account Name</th>
                            <th style="width: 140px;">Department</th>
                            <th>Narration / Memo</th>
                            <th style="width: 130px;" class="text-end">Debit (₱)</th>
                            <th style="width: 130px;" class="text-end">Credit (₱)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model)
                        {
                            <tr>
                                <td class="small">@(line.JournalEntry?.EntryDate.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td class="fw-bold font-monospace">
                                    <a asp-action="Details" asp-route-id="@line.JournalEntryId" class="text-decoration-none">
                                        @(line.JournalEntry?.JournalNumber ?? $"#{line.JournalEntryId}")
                                    </a>
                                </td>
                                <td class="font-monospace fw-semibold">@line.AccountCode</td>
                                <td>@line.AccountName</td>
                                <td class="small text-muted">@(string.IsNullOrEmpty(line.DepartmentName) ? "-" : line.DepartmentName)</td>
                                <td class="small">@(string.IsNullOrEmpty(line.Description) ? line.JournalEntry?.Description : line.Description)</td>
                                <td class="text-end fw-semibold">
                                    @(line.DebitAmount > 0 ? line.DebitAmount.ToString("N2") : "-")
                                </td>
                                <td class="text-end fw-semibold">
                                    @(line.CreditAmount > 0 ? line.CreditAmount.ToString("N2") : "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="6" class="text-end">Activity Totals:</td>
                            <td class="text-end text-primary fs-6">₱@totalDebits.ToString("N2")</td>
                            <td class="text-end text-primary fs-6">₱@totalCredits.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end">Net Movement:</td>
                            <td colspan="2" class="text-end text-success fs-6">₱@(Math.Abs(totalDebits - totalCredits).ToString("N2"))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-book fs-1 text-muted d-block mb-3"></i>
                <h5>No Ledger Activity Found</h5>
                <p class="text-muted">There are no posted journal lines matching the selected parameters.</p>
            </div>
        }
    </div>
</div>

