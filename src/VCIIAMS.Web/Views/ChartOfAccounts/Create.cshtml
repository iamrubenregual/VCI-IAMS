@model ChartOfAccount

@{
    ViewData["Title"] = "Create Account";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/ChartOfAccounts'>Chart of Accounts</a></li><li class='breadcrumb-item active'>Create</li>";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Create New Account</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AccountCode" class="form-label"></label>
                            <input asp-for="AccountCode" class="form-control" placeholder="e.g., 1000" />
                            <span asp-validation-for="AccountCode" class="text-danger small"></span>
                            <small class="form-text text-muted">Unique account code (required)</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AccountTypeId" class="form-label"></label>
                            <select asp-for="AccountTypeId" class="form-select" asp-items="ViewBag.AccountTypes">
                                <option value="">-- Select Account Type --</option>
                            </select>
                            <span asp-validation-for="AccountTypeId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label"></label>
                        <input asp-for="AccountName" class="form-control" placeholder="e.g., ASSETS" />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentAccountId" class="form-label"></label>
                        <select asp-for="ParentAccountId" class="form-select" asp-items="ViewBag.ParentAccounts">
                            <option value="">-- No Parent (Root Level) --</option>
                        </select>
                        <span asp-validation-for="ParentAccountId" class="text-danger small"></span>
                        <small class="form-text text-muted">Select a header account as parent</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Optional description"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="OpeningBalance" class="form-label"></label>
                            <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" value="0" />
                            <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpeningBalanceDate" class="form-label"></label>
                            <input asp-for="OpeningBalanceDate" class="form-control" type="date" />
                            <span asp-validation-for="OpeningBalanceDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Level" class="form-label"></label>
                            <input asp-for="Level" class="form-control" type="number" min="1" max="10" value="1" />
                            <span asp-validation-for="Level" class="text-danger small"></span>
                            <small class="form-text text-muted">Account hierarchy level (1-10)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsHeader" class="form-check-input" type="checkbox" />
                            <label asp-for="IsHeader" class="form-check-label"></label>
                        </div>
                        <small class="form-text text-muted">
                            Header accounts are for grouping and cannot have transactions posted directly
                        </small>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="AllowManualEntry" class="form-check-input" type="checkbox" checked />
                            <label asp-for="AllowManualEntry" class="form-check-label"></label>
                        </div>
                        <small class="form-text text-muted">
                            Uncheck if this account should only accept system-generated transactions
                        </small>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Toggle opening balance based on header checkbox
            $('#IsHeader').change(function () {
                if ($(this).is(':checked')) {
                    $('#OpeningBalance').val(0).prop('disabled', true);
                    $('#AllowManualEntry').prop('checked', false).prop('disabled', true);
                } else {
                    $('#OpeningBalance').prop('disabled', false);
                    $('#AllowManualEntry').prop('disabled', false);
                }
            });
        });
    </script>
}
