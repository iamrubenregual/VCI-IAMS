@model ChartOfAccount

@{
    ViewData["Title"] = "Edit Account";
    ViewData["Breadcrumb"] = $"<li class='breadcrumb-item'><a href='/ChartOfAccounts'>Chart of Accounts</a></li><li class='breadcrumb-item active'>Edit - {Model.AccountCode}</li>";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card" style="width: 100%;">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Account: @Model.AccountCode</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input asp-for="AccountId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AccountCode" class="form-label"></label>
                            <input asp-for="AccountCode" class="form-control" />
                            <span asp-validation-for="AccountCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AccountTypeId" class="form-label"></label>
                            <select asp-for="AccountTypeId" class="form-select" asp-items="ViewBag.AccountTypes">
                                <option value="">-- Select Account Type --</option>
                            </select>
                            <span asp-validation-for="AccountTypeId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label"></label>
                        <input asp-for="AccountName" class="form-control" />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentAccountId" class="form-label"></label>
                        <select asp-for="ParentAccountId" class="form-select" asp-items="ViewBag.ParentAccounts">
                            <option value="">-- No Parent (Root Level) --</option>
                        </select>
                        <span asp-validation-for="ParentAccountId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="OpeningBalance" class="form-label"></label>
                            <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpeningBalanceDate" class="form-label"></label>
                            <input asp-for="OpeningBalanceDate" class="form-control" type="date" />
                            <span asp-validation-for="OpeningBalanceDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Level" class="form-label"></label>
                            <input asp-for="Level" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="Level" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsHeader" class="form-check-input" type="checkbox" />
                            <label asp-for="IsHeader" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="AllowManualEntry" class="form-check-input" type="checkbox" />
                            <label asp-for="AllowManualEntry" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <!-- Metadata -->
                    <div class="card bg-light mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Metadata</h6>
                            <dl class="row mb-0 small">
                                <dt class="col-sm-4">Created By:</dt>
                                <dd class="col-sm-8">@Model.CreatedBy on @Model.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")</dd>

                                @if (!string.IsNullOrEmpty(Model.ModifiedBy))
                                {
                                    <dt class="col-sm-4">Last Modified By:</dt>
                                    <dd class="col-sm-8">@Model.ModifiedBy on @Model.ModifiedDate?.ToString("MMM dd, yyyy hh:mm tt")</dd>
                                }
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Details" asp-route-id="@Model.AccountId" class="btn btn-outline-info">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
