@model IEnumerable<FiscalPeriod>

@{
    ViewData["Title"] = "All Fiscal Periods";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title">All Fiscal Periods</h2>
        <p class="text-muted mb-0">View and manage all fiscal periods across years</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Back to Fiscal Years
    </a>
</div>

<!-- Filters -->
<div class="filters-section">
    <form method="get" class="d-flex gap-3 align-items-center w-100 flex-wrap">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search periods..." class="form-control" id="searchInput" />
        </div>

        <select name="fiscalYearId" class="form-select" style="max-width: 250px;" onchange="this.form.submit()">
            <option value="">All Fiscal Years</option>
            @if (ViewBag.FiscalYears != null)
            {
                @foreach (var item in ViewBag.FiscalYears)
                {
                    <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedFiscalYearId?.ToString())">
                        @item.Text
                    </option>
                }
            }
        </select>

        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="includeInactive"
                   id="includeInactive" value="true" @(ViewBag.IncludeInactive ? "checked" : "")
                   onchange="this.form.submit()">
            <label class="form-check-label" for="includeInactive">
                Include Inactive
            </label>
        </div>
    </form>
</div>

<!-- Periods Table -->
<div class="data-table">
    @if (Model != null && Model.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>Fiscal Year</th>
                    <th>Period Code</th>
                    <th>Period Name</th>
                    <th>Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Days</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="periodsTableBody">
                @foreach (var period in Model)
                {
                    <tr>
                        <td>
                            <strong>@period.FiscalYearName</strong><br />
                            <small class="text-muted">@period.FiscalYearCode</small>
                        </td>
                        <td><span class="badge bg-info">@period.PeriodCode</span></td>
                        <td>@period.PeriodName</td>
                        <td><span class="badge bg-secondary">@period.PeriodType</span></td>
                        <td>@period.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@period.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>@period.DaysInPeriod days</td>
                        <td class="text-center">
                            @if (period.IsClosed)
                            {
                                <span class="status-badge secondary">
                                    <span class="status-dot secondary"></span>
                                    Closed
                                </span>
                            }
                            else if (DateTime.Today >= period.StartDate && DateTime.Today <= period.EndDate)
                            {
                                <span class="status-badge success">
                                    <span class="status-dot success"></span>
                                    Current
                                </span>
                            }
                            else if (DateTime.Today < period.StartDate)
                            {
                                <span class="status-badge warning">
                                    <span class="status-dot warning"></span>
                                    Upcoming
                                </span>
                            }
                            else
                            {
                                <span class="status-badge info">
                                    <span class="status-dot info"></span>
                                    Past
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!period.IsClosed)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        onclick="closePeriod(@period.FiscalPeriodId, '@period.PeriodName', @period.FiscalYearId)">
                                    <i class="bi bi-lock"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="padding: 20px; color: var(--text-secondary); font-size: 14px;">
            <i class="bi bi-info-circle"></i>
            Showing <strong>@Model.Count()</strong> fiscal period(s)
        </div>
    }
    else
    {
        <div style="padding: 40px; text-align: center; color: var(--text-secondary);">
            <i class="bi bi-calendar-x" style="font-size: 48px; opacity: 0.3;"></i>
            <p class="mt-3">No fiscal periods found. <a asp-action="CreateYear">Create a fiscal year</a> to get started.</p>
        </div>
    }
</div>

<!-- Close Period Modal -->
<div id="closePeriodModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background: white; border-radius: 12px; padding: 30px; max-width: 500px; width: 90%;">
        <h5 style="margin-bottom: 20px;"><i class="bi bi-exclamation-triangle text-warning"></i> Close Fiscal Period</h5>
        <p>Are you sure you want to close period <strong id="periodName"></strong>?</p>
        <p class="text-warning"><i class="bi bi-info-circle"></i> Closing a period prevents further transactions in that period.</p>

        <form id="closePeriodForm" method="post" style="margin-top: 30px;">
            <input type="hidden" name="fiscalYearId" id="fiscalYearIdInput" />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-lock"></i> Close Period
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function closePeriod(id, name, fiscalYearId) {
            $('#periodName').text(name);
            $('#fiscalYearIdInput').val(fiscalYearId);
            $('#closePeriodForm').attr('action', '/FiscalPeriods/ClosePeriod/' + id);
            $('#closePeriodModal').css('display', 'flex');
        }

        function closeModal() {
            $('#closePeriodModal').css('display', 'none');
        }

        // Search functionality
        $('#searchInput').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            $('#periodsTableBody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    </script>
}
