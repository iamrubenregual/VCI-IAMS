@model IEnumerable<FiscalYear>

@{
    ViewData["Title"] = "Fiscal Years";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item active'>Fiscal Years</li>";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="bi bi-calendar-range"></i> Fiscal Years</h2>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="CreateYear" class="btn btn-primary">
            <i class="bi bi-calendar-plus"></i> Create New Fiscal Year
        </a>
    </div>
</div>

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="includeInactive"
                           id="includeInactive" value="true" @(ViewBag.IncludeInactive ? "checked" : "")>
                    <label class="form-check-label" for="includeInactive">
                        Include Inactive Fiscal Years
                    </label>
                </div>
            </div>
            <div class="col-md-6 text-end">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel"></i> Apply Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Fiscal Years List -->
<div class="row" style="width: 100%;">
    @if (Model != null && Model.Any())
    {
        @foreach (var fiscalYear in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100 @(fiscalYear.IsClosed ? "border-secondary" : "border-success")">
                    <div class="card-header @(fiscalYear.IsClosed ? "bg-secondary" : "bg-success") text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-range"></i> @fiscalYear.FiscalYearName
                            </h5>
                            <span class="badge @(fiscalYear.IsClosed ? "bg-dark" : "bg-light text-dark")" style="margin-left: 10px">
                                @fiscalYear.StatusDisplay
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Fiscal Year Code:</dt>
                            <dd class="col-sm-7"><strong>@fiscalYear.FiscalYearCode</strong></dd>

                            <dt class="col-sm-5">Date Range:</dt>
                            <dd class="col-sm-7">
                                @fiscalYear.StartDate.ToString("MMM dd, yyyy") - @fiscalYear.EndDate.ToString("MMM dd, yyyy")
                            </dd>

                            <dt class="col-sm-5">Duration:</dt>
                            <dd class="col-sm-7">@((fiscalYear.EndDate - fiscalYear.StartDate).Days + 1) days</dd>

                            <dt class="col-sm-5">Periods:</dt>
                            <dd class="col-sm-7">
                                <span class="badge bg-info">@fiscalYear.PeriodCount period(s)</span>
                            </dd>

                            <dt class="col-sm-5">Status:</dt>
                            <dd class="col-sm-7">
                                @if (fiscalYear.IsClosed)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </dd>

                            @if (fiscalYear.IsClosed)
                            {
                                <dt class="col-sm-5">Closed By:</dt>
                                <dd class="col-sm-7">@fiscalYear.ClosedBy on @fiscalYear.ClosedDate?.ToString("MMM dd, yyyy")</dd>
                            }
                        </dl>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@fiscalYear.FiscalYearId"
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                            <div class="btn-group btn-group-sm" role="group">
                                @if (!fiscalYear.IsClosed)
                                {
                                    <a asp-action="EditYear" asp-route-id="@fiscalYear.FiscalYearId"
                                       class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-outline-warning"
                                            onclick="closeFiscalYear(@fiscalYear.FiscalYearId, '@fiscalYear.FiscalYearName')">
                                        <i class="bi bi-lock"></i> Close
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>
                                        <i class="bi bi-lock-fill"></i> Closed
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i>
                No fiscal years found. <a asp-action="CreateYear" class="alert-link">Create your first fiscal year</a>.
            </div>
        </div>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="mt-3">
        <p class="text-muted">
            <i class="bi bi-info-circle"></i>
            Showing <strong>@Model.Count()</strong> fiscal year(s).
        </p>
    </div>
}

<!-- Close Fiscal Year Modal -->
<div class="modal fade" id="closeFiscalYearModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Close Fiscal Year
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to close fiscal year <strong id="fiscalYearName"></strong>?</p>
                <p class="text-danger">
                    <i class="bi bi-exclamation-circle"></i>
                    Once closed, you will not be able to edit or reopen this fiscal year.
                </p>
            </div>
            <div class="modal-footer">
                <form id="closeFiscalYearForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-lock"></i> Close Fiscal Year
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function closeFiscalYear(id, name) {
            $('#fiscalYearName').text(name);
            $('#closeFiscalYearForm').attr('action', '/FiscalPeriods/CloseYear/' + id);
            var modal = new bootstrap.Modal(document.getElementById('closeFiscalYearModal'));
            modal.show();
        }
    </script>
}
